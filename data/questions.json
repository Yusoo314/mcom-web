[
  {"id":1,"text":"进入陌生环境，比起自己心态的变化，你通常会优先把注意力投向外部变化和新鲜事物。","dimension":"exploration","pole":"O","scoring":"forward"},
  {"id":2,"text":"你对外界的新情况通常很敏感，并愿意主动参与进去。","dimension":"exploration","pole":"O","scoring":"forward"},
  {"id":3,"text":"你觉得改变世界比改变自己更紧迫。","dimension":"exploration","pole":"O","scoring":"forward"},
  {"id":4,"text":"比起自己的好奇心和求知欲，外界的变化与挑战更能激发你的行动力。","dimension":"exploration","pole":"O","scoring":"forward"},
  {"id":5,"text":"世界向你抛出问题，而不是由你自己提出。","dimension":"exploration","pole":"O","scoring":"forward"},
  {"id":6,"text":"当你接触到新的概念时，你会先想它是否适用于现实问题。","dimension":"exploration","pole":"O","scoring":"forward"},
  {"id":7,"text":"空闲时，你更愿意外出参与活动，而不是独自整理思绪。","dimension":"exploration","pole":"O","scoring":"forward"},
  {"id":8,"text":"讨论问题时，你习惯用他人的案例来说明观点。","dimension":"exploration","pole":"O","scoring":"forward"},
  {"id":9,"text":"你认同旅途的终点就是你出发的地方。","dimension":"exploration","pole":"I","scoring":"reverse"},
  {"id":10,"text":"你更容易被内心的疑问驱动，而不是外界目标。","dimension":"exploration","pole":"I","scoring":"reverse"},
  {"id":11,"text":"你觉得理解自己比理解世界更根本。","dimension":"exploration","pole":"I","scoring":"reverse"},
  {"id":12,"text":"面对外界事物变化时，你往往会沉浸在内心的感受里。","dimension":"exploration","pole":"I","scoring":"reverse"},
  {"id":13,"text":"你习惯通过反思来确认自己的存在。","dimension":"exploration","pole":"I","scoring":"reverse"},
  {"id":14,"text":"你更喜欢“想明白”，而非“做出来”。","dimension":"exploration","pole":"I","scoring":"reverse"},
  {"id":15,"text":"你通常会在行动前想清楚自己为什么要这样做。","dimension":"exploration","pole":"I","scoring":"reverse"},
  {"id":16,"text":"你评估局势时，会先判断事情背后有没有清晰的逻辑结构。","dimension":"anticipatory","pole":"C","scoring":"forward"},
  {"id":17,"text":"你更容易被“逻辑上成立”说服。","dimension":"anticipatory","pole":"C","scoring":"forward"},
  {"id":18,"text":"你习惯问“这背后有什么规律”。","dimension":"anticipatory","pole":"C","scoring":"forward"},
  {"id":19,"text":"你习惯通过分析因果关系来预判事情的发展。","dimension":"anticipatory","pole":"C","scoring":"forward"},
  {"id":20,"text":"在处理事情之前，你习惯先梳理背后存在的系统和逻辑链。","dimension":"anticipatory","pole":"C","scoring":"forward"},
  {"id":21,"text":"面对失败，你先找流程或方法的问题。","dimension":"anticipatory","pole":"C","scoring":"forward"},
  {"id":22,"text":"你习惯用模型来理解复杂现象。","dimension":"anticipatory","pole":"C","scoring":"forward"},
  {"id":23,"text":"对于你来说，理解系统比理解需求更容易。","dimension":"anticipatory","pole":"C","scoring":"forward"},
  {"id":24,"text":"你在分析问题时，常常会优先考虑背后的目的、意图或需求。","dimension":"anticipatory","pole":"T","scoring":"reverse"},
  {"id":25,"text":"你认为“谁说的”会很大程度影响你对一种观点的看法。","dimension":"anticipatory","pole":"T","scoring":"reverse"},
  {"id":26,"text":"面对争议时，你往往会先关注各方背后的意图与立场。","dimension":"anticipatory","pole":"T","scoring":"reverse"},
  {"id":27,"text":"你在理解一件事时，往往会先揣摩相关人的真实想法。","dimension":"anticipatory","pole":"T","scoring":"reverse"},
  {"id":28,"text":"你相信人的选择通常不可预测。","dimension":"anticipatory","pole":"T","scoring":"reverse"},
  {"id":29,"text":"面对失败，你先想是不是人的问题。","dimension":"anticipatory","pole":"T","scoring":"reverse"},
  {"id":30,"text":"你更容易被“有温度的解释”说服。","dimension":"anticipatory","pole":"T","scoring":"reverse"},
  {"id":31,"text":"你做事时，不喜欢有中间环节。","dimension":"operational","pole":"D","scoring":"forward"},
  {"id":32,"text":"你更愿意先亲自试一下，而不是先看别人的总结。","dimension":"operational","pole":"D","scoring":"forward"},
  {"id":33,"text":"面对陌生任务时，你通常会先行动，再在过程中调整。","dimension":"operational","pole":"D","scoring":"forward"},
  {"id":34,"text":"你习惯直接找当事人沟通。","dimension":"operational","pole":"D","scoring":"forward"},
  {"id":35,"text":"在实际接触对象之前，你一般不会修正自己的理解。","dimension":"operational","pole":"D","scoring":"forward"},
  {"id":36,"text":"你习惯自己动手，而非指挥别人。","dimension":"operational","pole":"D","scoring":"forward"},
  {"id":37,"text":"你在执行任务时，通常更愿意自己直接完成关键部分。","dimension":"operational","pole":"D","scoring":"forward"},
  {"id":38,"text":"你面对问题时，更容易先想到自己能直接做些什么。","dimension":"operational","pole":"D","scoring":"forward"},
  {"id":39,"text":"你更习惯通过系统、流程或工具来推进工作。","dimension":"operational","pole":"M","scoring":"reverse"},
  {"id":40,"text":"解决问题时，你先查资料或请教专家。","dimension":"operational","pole":"M","scoring":"reverse"},
  {"id":41,"text":"面对复杂情况，你倾向分步处理。","dimension":"operational","pole":"M","scoring":"reverse"},
  {"id":42,"text":"你更倾向用已有制度和规章流程推进问题。","dimension":"operational","pole":"M","scoring":"reverse"},
  {"id":43,"text":"面对冲突，你倾向通过第三方协调。","dimension":"operational","pole":"M","scoring":"reverse"},
  {"id":44,"text":"你解决问题时，先找“现有系统能做什么”。","dimension":"operational","pole":"M","scoring":"reverse"},
  {"id":45,"text":"你习惯给别人分配任务，而不是自己解决。","dimension":"operational","pole":"M","scoring":"reverse"},
  {"id":46,"text":"当一个决定不符合你的观点，你往往无法真正认同。","dimension":"reference","pole":"S","scoring":"forward"},
  {"id":47,"text":"比起让关系更和谐，你更在意自己的行为是否合乎内心认同。","dimension":"reference","pole":"S","scoring":"forward"},
  {"id":48,"text":"你常常会把自己的判断放在他人意见之前。","dimension":"reference","pole":"S","scoring":"forward"},
  {"id":49,"text":"你通常不会因为环境压力而轻易妥协。","dimension":"reference","pole":"S","scoring":"forward"},
  {"id":50,"text":"面对批评，你先想怎么反驳。","dimension":"reference","pole":"S","scoring":"forward"},
  {"id":51,"text":"你认为事情不按你的节奏推进就会失控。","dimension":"reference","pole":"S","scoring":"forward"},
  {"id":52,"text":"你不喜欢附议别人的观点。","dimension":"reference","pole":"S","scoring":"forward"},
  {"id":53,"text":"你往往希望自己的作品与别人不同。","dimension":"reference","pole":"S","scoring":"forward"},
  {"id":54,"text":"你容易因为团队关系和谐而感到满足。","dimension":"reference","pole":"R","scoring":"reverse"},
  {"id":55,"text":"你对结果的判断，更多来自群体共识。","dimension":"reference","pole":"R","scoring":"reverse"},
  {"id":56,"text":"你比较不容易为了顾及关系而放弃自己的立场。","dimension":"reference","pole":"R","scoring":"reverse"},
  {"id":57,"text":"你重视共同约定的制定与执行。","dimension":"reference","pole":"R","scoring":"reverse"},
  {"id":58,"text":"你容易被能服务他人的工作吸引。","dimension":"reference","pole":"R","scoring":"reverse"},
  {"id":59,"text":"你总是希望自己在某个团队中扮演某种角色。","dimension":"reference","pole":"R","scoring":"reverse"},
  {"id":60,"text":"你总是先和团队达成共识，再行动。","dimension":"reference","pole":"R","scoring":"reverse"}
]
